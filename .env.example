# SolidCraft Gallery — deployment and runtime configuration.
#
# Copy this file to `.env`, fill the secrets, then run `./scripts/deploy.sh`.
# `.env` is gitignored and must never be committed. Everything the Ansible
# playbook, Docker Compose, Caddy and the application need lives here.
#
#   cp .env.example .env
#   chmod 600 .env
#   openssl rand -base64 32   # SESSION_SECRET, TOKEN_ENC_KEY, SIGNED_URL_SECRET
#   openssl rand -hex 24      # POSTGRES_PASSWORD, FORGEJO_DB_PASSWORD, admin password

# ── Ansible / SSH ─────────────────────────────────────────────────────────────
# The host and account the playbook connects to. The default matches the
# single-host deployment this repository ships with.
DEPLOY_HOST=192.168.88.222
DEPLOY_USER=root
DEPLOY_SSH_PORT=22
# Optional path to a private key. Leave empty to use ssh-agent / ~/.ssh/config.
DEPLOY_SSH_KEY=
# Absolute directory on the remote host. SOLIDCRAFT_CLI_PATH must live under it.
DEPLOY_DIR=/opt/solidcraft-gallery
# Refuse to deploy an uncommitted working tree unless this is 1.
DEPLOY_ALLOW_DIRTY=0
# Take a pg_dump before migrations and keep the newest N dumps.
DEPLOY_BACKUP_BEFORE_DEPLOY=1
DEPLOY_KEEP_BACKUPS=5

# ── Domains and ports ─────────────────────────────────────────────────────────
# Hostnames only (no scheme). Caddy serves the web app on WEB_PORT and Forgejo
# on FORGEJO_PORT; the same hostnames are used for TLS when it is enabled.
WEB_DOMAIN=solidcraft.drun.net
FORGEJO_DOMAIN=forgejo.drun.net
PUBLIC_ORIGIN=https://solidcraft.drun.net
FORGEJO_PUBLIC_URL=https://forgejo.drun.net/
ACME_EMAIL=admin@drun.net

WEB_PORT=8080
FORGEJO_PORT=8081
FORGEJO_SSH_PORT=2222
# Kept on loopback; do not expose PostgreSQL publicly.
POSTGRES_PORT=5432

# off: serve only 8080/8081 (HTTP; use an external TLS terminator if desired).
# on:  also publish 80/443 and let Caddy obtain certificates for the domains.
CADDY_AUTO_HTTPS=off

# ── Compose / images ──────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=gallery
# Built on the controller and loaded on the host by the playbook.
WEB_IMAGE=gallery-web:local
WORKER_IMAGE=gallery-worker:local
CADDY_IMAGE=caddy:2-alpine
POSTGRES_IMAGE=postgres:16-alpine
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:9

# ── Application ───────────────────────────────────────────────────────────────
APP_VERSION=dev
# Compose builds the internal DATABASE_URL from the POSTGRES_* values below.
# Local commands such as `pnpm db:migrate` can use:
# DATABASE_URL=postgres://gallery:change-me@localhost:5432/gallery
POSTGRES_USER=gallery
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gallery
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASSWORD=change-me

# 32+ random bytes, base64. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me
# 32 bytes base64, used to encrypt provider tokens at rest.
TOKEN_ENC_KEY=change-me
# HMAC secret for private media URLs.
SIGNED_URL_SECRET=change-me

DATA_DIR=/var/lib/gallery
# Host path of the pinned CLI. The playbook uploads SOLIDCRAFT_CLI_SOURCE here.
SOLIDCRAFT_CLI_PATH=/opt/solidcraft-gallery/bin/solidcraft-cli
# Path on the machine running Ansible. Required on first deploy.
SOLIDCRAFT_CLI_SOURCE=
SOLIDCRAFT_CLI_VERSION=0.21.0

# ── Forgejo ───────────────────────────────────────────────────────────────────
FORGEJO_DISABLE_REGISTRATION=true
FORGEJO_LOG_LEVEL=info
# First-boot admin. The playbook creates it idempotently; change the password
# before the first deploy. Set FORGEJO_BOOTSTRAP_ADMIN=1 only for bootstrap.
FORGEJO_BOOTSTRAP_ADMIN=1
FORGEJO_ADMIN_USERNAME=gallery-admin
FORGEJO_ADMIN_PASSWORD=change-me
FORGEJO_ADMIN_EMAIL=admin@drun.net
# Filled in after the Forgejo OAuth2 application is created.
FORGEJO_CLIENT_ID=
FORGEJO_CLIENT_SECRET=
# Server-side token for hosted repositories; leave empty to use local git.
FORGEJO_ADMIN_TOKEN=

# ── External repositories ─────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Optional read token for public GitHub repositories (higher rate limit).
GITHUB_TOKEN=

# ── Worker / renderer ────────────────────────────────────────────────────────
# nsjail is the production default; direct is development-only.
SANDBOX_MODE=nsjail
ALLOW_UNSANDBOXED_RENDER=0
RENDER_TIMEOUT_SECONDS=60
WORKER_CONCURRENCY=2
WORKER_PAUSED=0

# ── Limits and beta switches ─────────────────────────────────────────────────
MAX_DESIGN_BYTES=26214400
MAX_REPO_BYTES=1073741824
INVITE_REQUIRED=1
ADMIN_USERNAMES=gallery-admin
# Domain for generated placeholder emails when a beta account is created without one.
# BETA_EMAIL_DOMAIN=users.solidcraft.drun.net
PUBLISH_DISABLED=0
ALLOW_ANY_GIT_HOST=0
LOG_LEVEL=info
