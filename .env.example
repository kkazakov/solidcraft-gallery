# Public origin of the site, used for OAuth callbacks, CSP and absolute URLs.
PUBLIC_ORIGIN=http://localhost:8080

# PostgreSQL. The compose file uses these values for the local database.
DATABASE_URL=postgres://gallery:gallery@localhost:5432/gallery

# 32+ random bytes, base64. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# 32 bytes base64, used to encrypt provider tokens at rest.
TOKEN_ENC_KEY=change-me

# HMAC secret for private media URLs.
SIGNED_URL_SECRET=change-me

# Hosted git (Forgejo). PUBLIC is browser-facing; INTERNAL is server-to-server
# (compose sets http://forgejo:3000).
FORGEJO_PUBLIC_URL=http://localhost:8081
FORGEJO_INTERNAL_URL=http://localhost:3001
FORGEJO_CLIENT_ID=
FORGEJO_CLIENT_SECRET=

# External repositories (GitHub OAuth app)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Data directory for local git repositories, artifacts and work dirs.
DATA_DIR=./data

# Optional GitHub token for public-repository reads (higher rate limit).
GITHUB_TOKEN=

# Worker / renderer
SOLIDCRAFT_CLI=/usr/local/bin/solidcraft-cli
# direct is development-only; production uses nsjail.
SANDBOX_MODE=direct
ALLOW_UNSANDBOXED_RENDER=1
SOLIDCRAFT_CLI_VERSION=0.19.0
RENDER_TIMEOUT_SECONDS=60
WORKER_CONCURRENCY=2
WORKER_PAUSED=0

# Limits
MAX_DESIGN_BYTES=26214400
MAX_REPO_BYTES=1073741824

# Beta switches
INVITE_REQUIRED=1
ADMIN_USERNAMES=
PUBLISH_DISABLED=0

# Comma-separated. Empty means only the default provider hosts are allowed.
ALLOW_ANY_GIT_HOST=0

LOG_LEVEL=info
APP_VERSION=dev
